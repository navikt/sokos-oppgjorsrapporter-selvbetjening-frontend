---
import { ErrorSummary } from '@navikt/ds-react/ErrorSummary';
import { actions } from 'astro:actions';
import { Heading, VStack } from '@navikt/ds-react';
import Layout from '@src/layouts/Layout.astro';
import { text } from '@src/language/text.ts';
import Rapportliste from '@src/components/Rapportliste';

const { rapportId } = Astro.params;

const response = await (async () => {
  const id = Number(rapportId);

  if (isNaN(id) || !rapportId) {
    return { error: 'Ukjent rapportid', data: null };
  }

  const { data, error } = await Astro.callAction(actions.hentRapportMetadata, {
    id,
  });

  return {
    error: error?.message ?? '',
    data: data ?? null,
  };
})();
---

<Layout>
  <VStack gap="space-32">
    <div>
      <Heading size="large" level="1">{text.title}</Heading>
    </div>
    {
      response.error && (
        <ErrorSummary heading="Det oppstod en feil">
          <ErrorSummary.Item>{response.error}</ErrorSummary.Item>
        </ErrorSummary>
      )
    }
    {
      !response.error && response.data && (
        <Rapportliste rapportliste={response.data} client:load />
      )
    }
  </VStack>
</Layout>
