---
import { text } from '../language/text';
import Layout from '../layouts/Layout.astro';
import { Heading, VStack } from '@navikt/ds-react';
import Oppgjorsrapporter from '@src/components/astro-island/Oppgjorsrapporter.astro';

const id = Astro.url.searchParams.get('id');
---

<Layout>
  <VStack gap="space-32">
    <div>
      <Heading size={'large'}>
        {text.title}
      </Heading>
    </div>
    <Oppgjorsrapporter server:defer {id} />
  </VStack>
</Layout>
