---
import { RapportType } from '@src/schemas/types.ts';
import Layout from '@src/layouts/Layout.astro';
import { actions } from 'astro:actions';
import Rapportliste from '@src/components/Rapportliste.tsx';
import { virksomhetermedTilgangTilType } from '@utils/virksomhetTilganger.ts';
const { type, orgnr } = Astro.params;

const parsetRapportType = RapportType.safeParse(type);
if (!parsetRapportType.success) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const rapportType = parsetRapportType.data;

const response = await (async () => {
  if (!orgnr) {
    return { error: 'manglende orgnr', data: null };
  }

  const { data, error } = await Astro.callAction(
    actions.hentRapporterForVirksomhet,
    {
      orgnr,
      rapportType,
    },
  );

  if (!error && data?.orgNavn === undefined) {
    const { data: tilganger, error: organisasjonerError } =
      await Astro.callAction(actions.hentOrganisasjoner, {
        orgnr,
      });

    const virksomheter = virksomhetermedTilgangTilType(
      tilganger ?? [],
      rapportType,
    );
    const orgNavn = virksomheter.find((o) => o.orgnr === orgnr)?.navn;

    return {
      error: organisasjonerError?.message ?? 'Feil oppstod',
      data: {
        ...data,
        orgNavn,
      },
    };
  }

  return {
    error: error?.message ?? '',
    data: data ?? null,
  };
})();
---

<Layout
  rapportType={rapportType}
  smuler={[
    {
      url: `/oppgjorsrapporter/${rapportType}`,
      title: 'Velg organisasjonsenhet',
    },
    {
      url: `/oppgjorsrapporter/${rapportType}/${orgnr}`,
      title: `${response.data?.orgNavn ?? 'Feil oppstod'}`,
    },
  ]}
  title={response.data?.orgNavn ?? 'Feil oppstod'}
  error={response.error}
>
  {
    !response.error && response.data && (
      <Rapportliste rapportliste={response.data} client:load />
    )
  }
</Layout>
