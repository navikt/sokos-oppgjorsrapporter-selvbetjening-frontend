---
import { RapportType } from '@src/schemas/types.ts';
import Layout from '@src/layouts/Layout.astro';
import { DekoratorContext } from '@src/components/DekoratorContext.tsx';
const { type, orgnr } = Astro.params;

const parsetRapportType = RapportType.safeParse(type);
if (!parsetRapportType.success) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const rapportType = parsetRapportType.data;
---

<Layout>
  <DekoratorContext
    rapportType={rapportType}
    smuler={[
      {
        url: `/oppgjorsrapporter/${rapportType}`,
        title: 'Velg organisasjonsenhet',
      },
      {
        url: `/oppgjorsrapporter/${rapportType}/${orgnr}`,
        title: `${orgnr}`,
      },
    ]}
    client:load
  />
  <h1>{type} for {orgnr}</h1>
</Layout>
